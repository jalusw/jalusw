---
interface Props {
	type: 'circles' | 'bars' | 'grid' | 'type' | 'wave';
	class?: string;
}

const { type, class: className = '' } = Astro.props;
---

<div class:list={['relative h-full w-full overflow-hidden', className]} aria-hidden="true">
	<svg
		viewBox="0 0 400 500"
		preserveAspectRatio="xMidYMid slice"
		class="h-full w-full"
		fill="none"
	>
		{type === 'circles' && (
			<>
				<circle cx="200" cy="250" r="140" stroke="#000" stroke-width="1" />
				<circle cx="200" cy="250" r="64" fill="#000" />
			</>
		)}
		{type === 'bars' && (
			<>
				<rect x="60" y="330" width="56" height="120" fill="#000" />
				<rect x="132" y="250" width="56" height="200" fill="#000" />
				<rect x="204" y="180" width="56" height="270" fill="#000" />
				<rect x="276" y="90" width="56" height="360" fill="#000" />
			</>
		)}
		{type === 'grid' && (
			<>
				<rect x="60" y="110" width="280" height="280" stroke="#000" stroke-width="1" />
				<line x1="153" y1="110" x2="153" y2="390" stroke="#000" stroke-width="1" />
				<line x1="246" y1="110" x2="246" y2="390" stroke="#000" stroke-width="1" />
				<line x1="60" y1="203" x2="340" y2="203" stroke="#000" stroke-width="1" />
				<line x1="60" y1="296" x2="340" y2="296" stroke="#000" stroke-width="1" />
				<rect x="60" y="110" width="93" height="93" fill="#000" />
				<rect x="246" y="296" width="93" height="93" fill="#000" />
			</>
		)}
		{type === 'type' && (
			<text
				x="200"
				y="250"
				text-anchor="middle"
				dominant-baseline="central"
				font-family="Helvetica Neue, Helvetica, Arial, sans-serif"
				font-weight="700"
				font-size="300"
				letter-spacing="-16"
				fill="#000">Aa</text
			>
		)}
		{type === 'wave' && (
			<>
				{[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
					<line
						x1={30 + i * 10}
						y1={110 + i * 35}
						x2={370 - (8 - i) * 12}
						y2={110 + i * 35}
						stroke="#000"
						stroke-width={1 + i * 0.15}
					/>
				))}
			</>
		)}
	</svg>
</div>
